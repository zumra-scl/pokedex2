<h1><%= pokemon.name %></h1>

<img src="<%= pokemon.sprites.front_default %>" />

<p>ID: <%= pokemon.id %></p>
<p>Height: <%= pokemon.height %></p>
<p>Weight: <%= pokemon.weight %></p>

<h3>Abilities:</h3>
<ul>
  <% pokemon.abilities.forEach(a => { %>
    <li><%= a.ability.name %></li>
  <% }) %>
</ul>

<a href="/">Etusivulle</a>